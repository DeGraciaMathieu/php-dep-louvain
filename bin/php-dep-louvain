#!/usr/bin/env php
<?php

declare(strict_types=1);

// Standalone checkout, or installed as a dependency of another project
foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

exit((new PhpDepLouvain\Console\Application())->run($argv));
